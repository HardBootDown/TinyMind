import numpy as np


# ============================================================
# CONFIGURATION
# ============================================================

EMBEDDING_SIZE = 4
HIDDEN_SIZE = 16 #neurons

LEARNING_RATE = 0.001
TRAINING_EPOCHS = 1000

PRINT_EVERY = 10


# ============================================================
# TOKENIZER
# ============================================================

def tokenize(sentence):

    return sentence.lower().split()


# ============================================================
# LOAD TRAINING DATA
# ============================================================

def load_training_data(filename):

    with open(filename, "r", encoding="utf-8") as file:

        sentences = [
            line.strip()
            for line in file
            if line.strip()
        ]

    return sentences


# ============================================================
# BUILD VOCABULARY
# ============================================================

def build_vocabulary(tokenized_sentences):

    vocabulary = []

    for sentence in tokenized_sentences:

        for token in sentence:

            if token not in vocabulary:

                vocabulary.append(token)

    token_to_id = {
        token: index
        for index, token in enumerate(vocabulary)
    }

    id_to_token = {
        index: token
        for token, index in token_to_id.items()
    }

    return token_to_id, id_to_token


# ============================================================
# ENCODE SENTENCES
# ============================================================

def encode_sentences(tokenized_sentences, token_to_id):

    encoded = []

    for sentence in tokenized_sentences:

        encoded_sentence = [
            token_to_id[token]
            for token in sentence
        ]

        encoded.append(encoded_sentence)

    return encoded


# ============================================================
# CREATE EMBEDDING MATRIX
# ============================================================

def create_embedding_matrix(
    vocabulary_size,
    embedding_size
):

    return np.random.randn(
        vocabulary_size,
        embedding_size
    )


# ============================================================
# CREATE TRAINING PAIRS
#
# Example:
#
# [the, capital, of, france, is, paris]
#
# becomes:
#
# the     -> capital
# capital -> of
# of      -> france
# france  -> is
# is      -> paris
# ============================================================

def create_training_pairs(encoded_sentences):

    training_pairs = []

    for sentence in encoded_sentences:

        for index in range(len(sentence) - 1):

            input_token_id = sentence[index]

            target_token_id = sentence[index + 1]

            training_pairs.append(
                (
                    input_token_id,
                    target_token_id
                )
            )

    return training_pairs


# ============================================================
# RELU
# ============================================================

def relu(x):

    return np.maximum(0, x)


# ============================================================
# SOFTMAX
# ============================================================

def softmax(x):

    # Numerical stability
    shifted = x - np.max(x)

    exp_values = np.exp(shifted)

    return exp_values / np.sum(exp_values)


# ============================================================
# FORWARD PASS
# ============================================================

def forward_pass(
    input_vector,
    hidden_weights,
    hidden_biases,
    output_weights,
    output_biases
):

    # --------------------------------------------------------
    # HIDDEN LAYER
    # --------------------------------------------------------

    hidden_raw = (
        input_vector @ hidden_weights
        + hidden_biases
    )

    hidden_output = relu(hidden_raw)

    # --------------------------------------------------------
    # OUTPUT LAYER
    # --------------------------------------------------------

    logits = (
        hidden_output @ output_weights
        + output_biases
    )

    probabilities = softmax(logits)

    return (
        hidden_raw,
        hidden_output,
        logits,
        probabilities
    )


# ============================================================
# TRAIN ONE EXAMPLE
# ============================================================

def train_one_example(
    input_vector,
    target_token_id,
    hidden_weights,
    hidden_biases,
    output_weights,
    output_biases
):

    # --------------------------------------------------------
    # FORWARD PASS
    # --------------------------------------------------------

    (
        hidden_raw,
        hidden_output,
        logits,
        probabilities
    ) = forward_pass(
        input_vector,
        hidden_weights,
        hidden_biases,
        output_weights,
        output_biases
    )

    # --------------------------------------------------------
    # LOSS
    # --------------------------------------------------------

    target_probability = probabilities[target_token_id]

    loss = -np.log(
        target_probability + 1e-12
    )

    # --------------------------------------------------------
    # OUTPUT GRADIENT
    #
    # Softmax + cross entropy:
    #
    # gradient = probability - target
    # --------------------------------------------------------

    output_gradient = probabilities.copy()

    output_gradient[target_token_id] -= 1

    # --------------------------------------------------------
    # OUTPUT WEIGHT GRADIENT
    # --------------------------------------------------------

    output_weights_gradient = np.outer(
        hidden_output,
        output_gradient
    )

    # --------------------------------------------------------
    # OUTPUT BIAS GRADIENT
    # --------------------------------------------------------

    output_bias_gradient = output_gradient

    # --------------------------------------------------------
    # HIDDEN GRADIENT
    # --------------------------------------------------------

    hidden_gradient = (
        output_gradient @ output_weights.T
    )

    # --------------------------------------------------------
    # RELU DERIVATIVE
    # --------------------------------------------------------

    relu_gradient = (
        hidden_raw > 0
    ).astype(float)

    hidden_gradient *= relu_gradient

    # --------------------------------------------------------
    # HIDDEN WEIGHT GRADIENT
    # --------------------------------------------------------

    hidden_weights_gradient = np.outer(
        input_vector,
        hidden_gradient
    )

    # --------------------------------------------------------
    # HIDDEN BIAS GRADIENT
    # --------------------------------------------------------

    hidden_bias_gradient = hidden_gradient

    # --------------------------------------------------------
    # EMBEDDING GRADIENT
    #
    # The hidden layer receives:
    #
    # input_vector @ hidden_weights
    #
    # Therefore:
    #
    # dL/d(input_vector)
    # =
    # hidden_gradient @ hidden_weights.T
    # --------------------------------------------------------

    embedding_gradient = (
        hidden_gradient @ hidden_weights.T
    )

    # --------------------------------------------------------
    # RETURN GRADIENTS
    #
    # We update the parameters outside this function.
    # --------------------------------------------------------

    return (
        loss,
        probabilities,
        output_weights_gradient,
        output_bias_gradient,
        hidden_weights_gradient,
        hidden_bias_gradient,
        embedding_gradient
    )


# ============================================================
# UPDATE PARAMETERS
# ============================================================

def update_parameters(
    embedding_matrix,
    input_token_id,
    embedding_gradient,
    hidden_weights,
    hidden_biases,
    hidden_weights_gradient,
    hidden_bias_gradient,
    output_weights,
    output_biases,
    output_weights_gradient,
    output_bias_gradient
):

    # --------------------------------------------------------
    # UPDATE EMBEDDING
    # --------------------------------------------------------

    embedding_matrix[input_token_id] -= (
        LEARNING_RATE
        * embedding_gradient
    )

    # --------------------------------------------------------
    # UPDATE HIDDEN LAYER
    # --------------------------------------------------------

    hidden_weights -= (
        LEARNING_RATE
        * hidden_weights_gradient
    )

    hidden_biases -= (
        LEARNING_RATE
        * hidden_bias_gradient
    )

    # --------------------------------------------------------
    # UPDATE OUTPUT LAYER
    # --------------------------------------------------------

    output_weights -= (
        LEARNING_RATE
        * output_weights_gradient
    )

    output_biases -= (
        LEARNING_RATE
        * output_bias_gradient
    )


# ============================================================
# PREDICT NEXT WORD
# ============================================================

def predict_next_word(
    input_token_id,
    embedding_matrix,
    hidden_weights,
    hidden_biases,
    output_weights,
    output_biases,
    id_to_token
):

    input_vector = (
        embedding_matrix[input_token_id]
    )

    (
        hidden_raw,
        hidden_output,
        logits,
        probabilities
    ) = forward_pass(
        input_vector,
        hidden_weights,
        hidden_biases,
        output_weights,
        output_biases
    )

    predicted_token_id = int(
        np.argmax(probabilities)
    )

    predicted_word = (
        id_to_token[predicted_token_id]
    )

    return (
        predicted_word,
        probabilities
    )


# ============================================================
# MAIN
# ============================================================

def main():

    # --------------------------------------------------------
    # RANDOM SEED
    #
    # Makes our experiment reproducible.
    # --------------------------------------------------------

    np.random.seed(42)

    # --------------------------------------------------------
    # LOAD DATA
    # --------------------------------------------------------

    sentences = load_training_data(
        "data.txt"
    )

    print(
        f"Loaded {len(sentences)} training sentences."
    )

    # --------------------------------------------------------
    # TOKENIZE
    # --------------------------------------------------------

    tokenized_sentences = [
        tokenize(sentence)
        for sentence in sentences
    ]

    # --------------------------------------------------------
    # VOCABULARY
    # --------------------------------------------------------

    token_to_id, id_to_token = (
        build_vocabulary(
            tokenized_sentences
        )
    )

    vocabulary_size = len(token_to_id)

    print(
        f"Vocabulary size: {vocabulary_size}"
    )

    # --------------------------------------------------------
    # ENCODE
    # --------------------------------------------------------

    encoded_sentences = encode_sentences(
        tokenized_sentences,
        token_to_id
    )

    # --------------------------------------------------------
    # CREATE TRAINING PAIRS
    # --------------------------------------------------------

    training_pairs = create_training_pairs(
        encoded_sentences
    )

    print(
        f"Training pairs: {len(training_pairs)}"
    )

    # --------------------------------------------------------
    # EMBEDDING MATRIX
    # --------------------------------------------------------

    embedding_matrix = create_embedding_matrix(
        vocabulary_size,
        EMBEDDING_SIZE
    )

    # --------------------------------------------------------
    # HIDDEN LAYER
    # --------------------------------------------------------

    hidden_weights = np.random.randn(
        EMBEDDING_SIZE,
        HIDDEN_SIZE
    )

    hidden_biases = np.random.randn(
        HIDDEN_SIZE
    )

    # --------------------------------------------------------
    # OUTPUT LAYER
    # --------------------------------------------------------

    output_weights = np.random.randn(
        HIDDEN_SIZE,
        vocabulary_size
    )

    output_biases = np.random.randn(
        vocabulary_size
    )

    # --------------------------------------------------------
    # SHOW TRAINING PAIRS
    # --------------------------------------------------------

    print()
    print("# TRAINING PAIRS")
    print()

    for input_token_id, target_token_id in training_pairs:

        input_word = (
            id_to_token[input_token_id]
        )

        target_word = (
            id_to_token[target_token_id]
        )

        print(
            f"{input_word:8} -> {target_word}"
        )

    # --------------------------------------------------------
    # TRAINING
    # --------------------------------------------------------

    print()
    print("# TRAINING")
    print()

    for epoch in range(
        1,
        TRAINING_EPOCHS + 1
    ):

        # ----------------------------------------------------
        # SHUFFLE TRAINING PAIRS
        #
        # This prevents the network from always seeing
        # the examples in exactly the same order.
        # ----------------------------------------------------

        shuffled_pairs = training_pairs.copy()

        np.random.shuffle(
            shuffled_pairs
        )

        total_loss = 0.0

        # ----------------------------------------------------
        # TRAIN ON EVERY PAIR
        # ----------------------------------------------------

        for (
            input_token_id,
            target_token_id
        ) in shuffled_pairs:

            # Get the current embedding
            input_vector = (
                embedding_matrix[input_token_id]
            )

            (
                loss,
                probabilities,
                output_weights_gradient,
                output_bias_gradient,
                hidden_weights_gradient,
                hidden_bias_gradient,
                embedding_gradient
            ) = train_one_example(
                input_vector,
                target_token_id,
                hidden_weights,
                hidden_biases,
                output_weights,
                output_biases
            )

            # ------------------------------------------------
            # UPDATE ALL PARAMETERS
            # ------------------------------------------------

            update_parameters(
                embedding_matrix,
                input_token_id,
                embedding_gradient,
                hidden_weights,
                hidden_biases,
                hidden_weights_gradient,
                hidden_bias_gradient,
                output_weights,
                output_biases,
                output_weights_gradient,
                output_bias_gradient
            )

            total_loss += loss

        # ----------------------------------------------------
        # AVERAGE LOSS
        # ----------------------------------------------------

        average_loss = (
            total_loss
            / len(training_pairs)
        )

        # ----------------------------------------------------
        # PRINT PROGRESS
        # ----------------------------------------------------

        if (
            epoch == 1
            or epoch % PRINT_EVERY == 0
        ):

            (
                predicted_word,
                probabilities
            ) = predict_next_word(
                token_to_id["france"],
                embedding_matrix,
                hidden_weights,
                hidden_biases,
                output_weights,
                output_biases,
                id_to_token
            )

            paris_probability = (
                probabilities[
                    token_to_id["paris"]
                ]
            )

            print(
                f"Epoch {epoch:3d} | "
                f"Loss: {average_loss:8.4f} | "
                f"France -> Paris: "
                f"{paris_probability:.6f} | "
                f"Prediction: {predicted_word}"
            )

    # --------------------------------------------------------
    # FINAL TESTS
    # --------------------------------------------------------

    print()
    print("# FINAL PREDICTIONS")
    print()

    test_words = [
        "the",
        "capital",
        "of",
        "france",
        "germany",
        "italy",
        "spain",
        "black",
        "brown",
        "dog",
        "can",
        "small",
        "large",
        "cat"
    ]

    for word in test_words:

        input_token_id = (
            token_to_id[word]
        )

        (
            predicted_word,
            probabilities
        ) = predict_next_word(
            input_token_id,
            embedding_matrix,
            hidden_weights,
            hidden_biases,
            output_weights,
            output_biases,
            id_to_token
        )

        probability = (
            probabilities[
                token_to_id[predicted_word]
            ]
        )

        print(
            f"{word:8} -> "
            f"{predicted_word:8} "
            f"({probability:.6f})"
        )

    # --------------------------------------------------------
    # SHOW SOME LEARNED EMBEDDINGS
    # --------------------------------------------------------

    print()
    print("# LEARNED EMBEDDINGS")
    print()

    for word in [
        "france",
        "paris",
        "germany",
        "berlin",
        "italy",
        "rome",
        "spain",
        "madrid"
    ]:

        token_id = token_to_id[word]

        vector = (
            embedding_matrix[token_id]
        )

        print(
            f"{word:8} "
            f"{np.round(vector, 4)}"
        )


# ============================================================
# PROGRAM ENTRY POINT
# ============================================================

if __name__ == "__main__":

    main()
